{
  "name": "ponyscapes-relay",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "python3 tools/build.py",
    "dev": "npm run build && wrangler dev -c relay/wrangler.toml",
    "deploy:relay": "npm run build && wrangler deploy -c relay/wrangler.toml",
    "deploy:pages": "npm run build && wrangler pages deploy",
    "deploy": "npm run deploy:relay && npm run deploy:pages",
    "bundle": "python3 tools/bundle.py",
    "art": "node tools/export-art.js",
    "art:check": "node tools/export-art.js --check",
    "rooms": "node tools/cave-rooms.js build",
    "rooms:samples": "node tools/cave-rooms.js samples",
    "test:dungeon": "node tools/test-dungeon.js",
    "test:downed": "node tools/test-downed.js",
    "test:warren": "node tools/test-warren.js",
    "test:loot": "node tools/test-loot.js",
    "test:skills": "node tools/test-skills.js",
    "test:waypoints": "node tools/test-waypoints.js",
    "test:genes": "node tools/test-genes.js",
    "test:pedigree": "node tools/test-pedigree.js",
    "test:hybrids": "node tools/test-hybrids.js",
    "test:sky": "node tools/test-sky.js",
    "test:apples": "node tools/test-apples.js",
    "test:taming": "node tools/test-taming.js",
    "test:markers": "node tools/test-markers.js",
    "test:castle": "node tools/test-castle.js",
    "test:farming": "node tools/test-farming.js",
    "test:castle": "node tools/test-castle.js",
    "test:saves": "node tools/test-saves.js",
    "test:elasticbag": "node tools/test-elasticbag.js",
    "test:sleep": "node tools/test-sleep.js"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
